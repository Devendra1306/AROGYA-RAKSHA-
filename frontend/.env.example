# Arogya Raksha Frontend Environment Variables

# The backend API URL. 
# For production (e.g. Vercel), set this to your hosted API server address (e.g. https://api.arogyaraksha.com/api).
# Defaults to http://localhost:5000/api if not specified.
VITE_API_URL=http://localhost:5000/api

# The Google Client ID registered in Google Cloud Console Credentials Manager.
# Provide a valid ID to enable real Google authentication popup using accounts on the user's device.
# If left empty, the application will fallback to the simulated account chooser dialog.
VITE_GOOGLE_CLIENT_ID=129111784182-17n7932kgfubstil8c8bf86g6s88otga.apps.googleusercontent.com
