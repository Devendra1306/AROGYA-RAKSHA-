{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|sw\\.js|manifest\\.json|logo\\.jpg|favicon\\.svg|.*\\.(?:png|jpg|jpeg|gif|webp|ico|svg|css|js|woff2?|map)).*)",
      "destination": "/index.html"
    }
  ]
}

